NODE_ENV=development
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://pulsewatch:pulsewatch@localhost:5432/pulsewatch
REDIS_URL=redis://localhost:6379

# 32-byte key, base64. Wraps each account's data key. Rotate by changing KEK_KID
# and adding the new key to KEK_KEYS as kid:base64,kid:base64.
KEK_KID=dev-1
KEK_KEYS=dev-1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# Polling cadence (seconds)
POLL_INTERVAL_SECONDS=600
POLL_JITTER_SECONDS=60

# CORS — phone apps don't need it, but the dashboard preview does in dev
CORS_ORIGIN=http://localhost:5173
