NODE_ENV=development
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://pulsewatch:pulsewatch@localhost:5432/pulsewatch
REDIS_URL=redis://localhost:6379

# 32-byte key, hex. Wraps each account's provider key at rest. Rotate by
# changing KEK_KID and adding the new key to KEK_KEYS as kid:hex,kid:hex.
KEK_KID=dev-1
KEK_KEYS=dev-1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# X25519 private key (32 bytes, hex). The phone fetches the corresponding
# public key from /v1/wrapping-keys/current and uses ECIES (X25519 + HKDF-SHA256
# + AES-256-GCM) to wrap the provider API key in transit. The plaintext exists
# only briefly in the request handler before being re-wrapped with KEK above.
WRAPPING_KID=wrap-dev-1
WRAPPING_PRIVKEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Polling cadence (seconds)
POLL_INTERVAL_SECONDS=600
POLL_JITTER_SECONDS=60

# CORS — phone apps don't need it, but the dashboard preview does in dev
CORS_ORIGIN=http://localhost:5173

# Push (all optional). Without these the dispatcher is a no-op and threshold
# evaluations still update last_fired_at without sending anything.
# APNs auth key (.p8). Newlines may be escaped as \n in dotenv.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=app.pulsewatch.PulseWatch
APNS_ENVIRONMENT=sandbox

# FCM v1 service-account credentials.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
