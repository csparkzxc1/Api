{
  "name": "pulsewatch",
  "private": true,
  "version": "0.1.0",
  "description": "AI API usage monitor for Apple Watch and Wear OS",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "backend",
    "shared-types"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "openapi:lint": "redocly lint openapi.yaml",
    "openapi:gen": "openapi-typescript openapi.yaml -o shared-types/src/generated.ts",
    "openapi:check": "pnpm openapi:gen && git diff --exit-code -- shared-types/src/generated.ts"
  },
  "devDependencies": {
    "@redocly/cli": "^2.30.3",
    "openapi-typescript": "^7.13.0"
  }
}
